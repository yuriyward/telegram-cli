{
  "name": "telegram-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram user-account CLI for AI agents.",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "tg": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --packages=external --outdir=dist",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix": "oxlint --type-aware --fix && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.1",
    "@js-temporal/polyfill": "0.5.1",
    "@mtcute/bun": "0.32.1",
    "@mtcute/core": "0.32.1",
    "commander": "15.0.0",
    "long": "5.3.2",
    "qrcode": "1.5.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/qrcode": "1.5.6",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-complexity": "2.1.8",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@mtcute/core@0.32.1": "patches/@mtcute%2Fcore@0.32.1.patch"
  }
}
